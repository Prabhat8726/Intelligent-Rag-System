# Secrets - never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Generated data and artefacts
synthetic_data/generated/
# Evaluation reports are committed (ADR-027); anything else written there is not.
evaluation/reports/*
!evaluation/reports/.gitkeep
!evaluation/reports/*.md
!evaluation/reports/*.json
# Local document storage (STORAGE_LOCAL_ROOT=storage) - anchored so it never matches source
# packages such as backend/src/docintel/storage/.
/storage/
/backend/storage/

# Editors / OS
.idea/
.vscode/
.DS_Store
