# Copy to .env with `make env` (generates JWT_SECRET_KEY for you). Never commit .env.
# Full reference: docs/development/configuration.md
# Quote values that contain spaces, e.g. SEED_USER_PASSWORD="correct horse battery staple"
# (uv, docker compose and pydantic all accept quoted values; unquoted spaces break uv).

# ------------------------------------------------------------------ application
APP_ENV=local
LOG_LEVEL=INFO
# LOG_FORMAT=console            # console | json (default: console for local, json elsewhere)
# API_DOCS_ENABLED=true         # default: enabled except in production
# CORS_ALLOWED_ORIGINS=         # not needed: Vite (dev) and nginx (docker) serve the API same-origin

# ------------------------------------------------------------------ database
# docker compose creates this user and database on first start.
POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel_local_only
POSTGRES_DB=docintel
POSTGRES_PORT=5432
# Used by processes on the host (make dev / migrate / seed / test). Keep in sync with the values above.
DATABASE_URL=postgresql+psycopg://docintel:docintel_local_only@localhost:5432/docintel
# Tests create and drop their own uniquely named databases on this server.
TEST_DATABASE_URL=postgresql+psycopg://docintel:docintel_local_only@localhost:5432/docintel

# ------------------------------------------------------------------ authentication
# At least 32 random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_output_of_secrets_token_urlsafe_48
JWT_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# Password for the demo users created by `make seed` (local/test only, min. 12 characters).
# Also used by `make process` to log in as analyst@docintel.local.
SEED_USER_PASSWORD=

# ------------------------------------------------------------------ uploads & storage
UPLOAD_MAX_BYTES=26214400
# API_MAX_BODY_BYTES=1048576    # limit for all other request bodies
UPLOAD_MAX_PAGES=200
UPLOAD_MAX_IMAGE_PIXELS=50000000
# local (filesystem) or s3 (any S3-compatible service: AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_BACKEND=local
# Relative paths resolve against the working directory (backend/ for `make dev`).
# docker compose overrides this with a shared volume at /data/storage.
STORAGE_LOCAL_ROOT=storage
# S3_BUCKET=
# S3_ENDPOINT_URL=              # leave empty for AWS; set for R2/MinIO
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=

# ------------------------------------------------------------------ background worker
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=5
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=30

# ------------------------------------------------------------------ OCR & understanding
# Tesseract must be installed for the worker (Docker image includes it): `make check-ocr`.
# TESSERACT_CMD=tesseract
# Tesseract languages joined by "+", e.g. eng+deu (language data must be installed).
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_UPSCALE_BELOW_DPI=250
OCR_PAGE_TIMEOUT_SECONDS=120
OCR_CONCURRENCY=2
OCR_REVIEW_BELOW_CONFIDENCE=50
# OCR_REMOVE_RULING_LINES=false # measured not to help (evaluation/reports/ocr.md)
PAGE_PREVIEW_WIDTH=1000
CLASSIFICATION_MIN_CONFIDENCE=0.7
CLASSIFICATION_LLM_FALLBACK=true
# Highest sensitivity whose text may be sent to the external LLM (PUBLIC|INTERNAL|CONFIDENTIAL|RESTRICTED).
# On the Gemini free tier only upload synthetic data, whatever this is set to.
AI_EXTERNAL_MAX_SENSITIVITY=INTERNAL

# ------------------------------------------------------------------ AI providers
LLM_PROVIDER=gemini
# Vectors for knowledge and document search: gemini (needs the key below), fastembed (local
# model: `cd backend && uv sync --extra local-embeddings`; downloads BAAI/bge-base-en-v1.5 on
# first use) or hashing (offline, lexical only). Without a key, search falls back to full text;
# after switching, run `make reembed`.
EMBEDDING_PROVIDER=gemini
# FASTEMBED_MODEL=BAAI/bge-base-en-v1.5
# FASTEMBED_CACHE_DIR=
# Create a key at https://aistudio.google.com/apikey and paste it here. Verify with `make check-ai`.
# Free tier: Google may use prompts to improve its products - use synthetic data only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_THINKING_LEVEL=LOW     # MINIMAL | LOW | MEDIUM | HIGH (unset = model default)
# LLM_TEMPERATURE=              # unset = model default (recommended for Gemini 3.x)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Client-side rate limits; set to your project's quota (see AI Studio > Usage).
LLM_REQUESTS_PER_MINUTE=10
EMBEDDING_REQUESTS_PER_MINUTE=60
# Maximum LLM requests per provider per UTC day (0 = unlimited); keep it at or below your
# project's daily quota. `make llm-usage` shows usage.
LLM_DAILY_REQUEST_BUDGET=200
# USD per million tokens per model, for cost estimates only. Copy current prices from the
# provider's pricing page; empty = cost shown as "not configured". Example shape:
# LLM_PRICING={"gemini-3.5-flash": {"input_per_mtok": 0.5, "output_per_mtok": 3.0}}

# Local model instead of Gemini: LLM_PROVIDER=ollama plus a model you pulled (`ollama pull ...`).
# Content stays in your deployment, so confidential documents may use it.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
# OLLAMA_FAST_MODEL=
# OLLAMA_VISION=false
# OLLAMA_KEEP_ALIVE=10m

# ------------------------------------------------------------------ structured extraction
# auto = call the LLM only when the layout rules are not confident; always; never (no AI calls).
EXTRACTION_LLM_MODE=auto
# Document confidence for auto-accept / analyst review (below MEDIUM = mandatory review).
EXTRACTION_CONFIDENCE_HIGH=0.85
EXTRACTION_CONFIDENCE_MEDIUM=0.6
EXTRACTION_ARITHMETIC_TOLERANCE=0.01
# EXTRACTION_MAX_PROMPT_CHARS=60000
# EXTRACTION_MAX_OUTPUT_TOKENS=8192
# EXTRACTION_VISION_BELOW_OCR_CONFIDENCE=70
# EXTRACTION_MAX_IMAGES=2
# EVIDENCE_FUZZY_THRESHOLD=85
# VENDOR_MATCH_MIN_SCORE=85

# ------------------------------------------------------------------ matching and review
# A difference resting on a value read below this confidence is "could not be verified"
# (warning) instead of a discrepancy. Price / quantity tolerances are rule parameters (/rules).
COMPARISON_MIN_CONFIDENCE=0.85
# Review task due dates per priority, in hours (JSON; omitted priorities keep their default).
# REVIEW_SLA_HOURS={"URGENT": 4, "HIGH": 24, "NORMAL": 72, "LOW": 168}

# ------------------------------------------------------------------ knowledge base & RAG
# KNOWLEDGE_TEXT_MAX_BYTES=2097152
# KNOWLEDGE_CHUNK_TARGET_TOKENS=500
# KNOWLEDGE_CHUNK_MAX_TOKENS=800
# KNOWLEDGE_CHUNK_OVERLAP_TOKENS=75
# RAG_TOP_K=6
# Evidence gate: below both, the answer is "insufficient evidence" and no model is called.
# RAG_MIN_TERM_COVERAGE=0.25
# RAG_MIN_DENSE_SIMILARITY=0.5   # model-specific: calibrate with `make evaluate`
# RAG_MAX_CONTEXT_TOKENS=3000
# RAG_GENERATION_ENABLED=true    # false = passages only, no generated answers

# ------------------------------------------------------------------ investigation agent
# The agent plans and analyses with the LLM above when one is configured and allowed;
# false = deterministic planning and analysis only (tools and rules always run).
# AGENT_LLM_ENABLED=true
# AGENT_MAX_TOOL_CALLS=30
# AGENT_MAX_LLM_CALLS=4
# AGENT_MAX_DOCUMENTS=3
# AGENT_TIMEOUT_SECONDS=180
# AGENT_TOOL_TIMEOUT_SECONDS=30
# AGENT_MAX_ACTIVE_RUNS_PER_USER=3

# ------------------------------------------------------------------ workflows
# Start these workflows when a document of the matching type finishes processing
# (comma-separated: INVOICE_PROCESSING, CONTRACT_REVIEW). Empty = start them by hand.
# WORKFLOW_AUTO_START=

# ------------------------------------------------------------------ MCP & API tokens
# API_TOKEN_MAX_DAYS=90
# stdio MCP server (`docintel mcp`): a personal token from the API tokens page. Secret.
# MCP_API_TOKEN=
# Streamable HTTP (`docintel mcp --transport http`): public URL and accepted Host headers.
# MCP_PUBLIC_URL=http://127.0.0.1:8001
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# ------------------------------------------------------------------ docker compose
WEB_PORT=8080
