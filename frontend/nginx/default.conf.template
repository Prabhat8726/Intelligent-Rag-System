# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only environment variables that are defined (API_UPSTREAM, the NGINX_* defaults set in the
# Dockerfile, and NGINX_LOCAL_RESOLVERS from the container's resolv.conf) are substituted;
# nginx's own $variables are left untouched.

# Coarse per-address limits at the edge (ADR-074); the API applies the per-user limits.
limit_req_zone $binary_remote_addr zone=api:10m rate=${NGINX_API_RATE};
limit_req_zone $binary_remote_addr zone=login:10m rate=${NGINX_LOGIN_RATE};

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Uploads (Phase 2) are capped at 25 MB by the API; reject larger bodies at the edge.
    client_max_body_size 26m;

    # Resolve the API's name per request (cached briefly) rather than once at start-up: a
    # recreated or rescheduled API container gets a new address, and a start-up lookup would
    # keep proxying to the old one (502) until nginx restarts.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 5s;
    set $api_upstream ${API_UPSTREAM};
    # $scheme here; https behind the TLS proxy of deploy/ (NGINX_FORWARDED_PROTO).
    set $forwarded_proto ${NGINX_FORWARDED_PROTO};

    # The client address: the connecting peer, unless it is a trusted proxy in front of this
    # one (deploy/: the TLS proxy), whose X-Forwarded-For then names the client.
    set_real_ip_from ${NGINX_REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    limit_req_status 429;
    limit_req_log_level warn;
    error_page 429 = @too_many_requests;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API and probes: the backend sets its own security headers.
    location /api/ {
        limit_req zone=api burst=${NGINX_API_BURST} nodelay;
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location = /api/v1/auth/login {
        limit_req zone=login burst=${NGINX_LOGIN_BURST} nodelay;
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location @too_many_requests {
        default_type application/problem+json;
        add_header Retry-After 1 always;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"Too many requests from this address; slow down."}';
    }

    location /health {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
    }

    # Fingerprinted build assets: cache forever.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA routes: always revalidate index.html so new deployments are picked up.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
