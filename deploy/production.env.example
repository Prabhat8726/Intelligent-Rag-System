# Staging / production settings for one Docker host (ADR-078).
# Copy to the repository root on the host as `.env` (git-ignored), replace every
# "replace_with_..." value, and keep the file readable by the deploying user only:
#   cp deploy/production.env.example .env && chmod 600 .env
# Every setting of .env.example can be added here; these are the ones a deployment must set.

# ------------------------------------------------------------------ environment
APP_ENV=production                      # or staging; both refuse insecure defaults
LOG_LEVEL=INFO

# ------------------------------------------------------------------ release
# Images built and scanned by .github/workflows/release.yml; deploy/deploy.sh sets IMAGE_TAG.
IMAGE_REGISTRY=ghcr.io/replace_with_github_owner
IMAGE_TAG=replace_with_release_tag

# ------------------------------------------------------------------ edge (Caddy)
DOMAIN=docintel.example.com
# ACME account e-mail for Let's Encrypt certificates, or "internal" (local CA, rehearsals).
CADDY_TLS=replace_with_admin_email

# ------------------------------------------------------------------ database
POSTGRES_USER=docintel
POSTGRES_PASSWORD=replace_with_random_password
POSTGRES_DB=docintel
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# ------------------------------------------------------------------ secrets
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_random_secret
# Bearer token Prometheus presents to /metrics (required when deployed).
METRICS_TOKEN=replace_with_random_secret
# Grafana's admin password (deploy/compose.observability.yml).
GRAFANA_ADMIN_PASSWORD=replace_with_random_secret

# ------------------------------------------------------------------ capacity
API_REPLICAS=2
WORKER_REPLICAS=1
WORKER_CONCURRENCY=1

# ------------------------------------------------------------------ AI providers
# The free Gemini tier may use submitted content to improve Google's products: use it with
# synthetic data only. For real documents use a paid tier, or a local model (Ollama), and keep
# AI_EXTERNAL_MAX_SENSITIVITY as low as your data requires.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=replace_with_real_key
AI_EXTERNAL_MAX_SENSITIVITY=INTERNAL
LLM_DAILY_REQUEST_BUDGET=200

# ------------------------------------------------------------------ retention
RETENTION_DELETED_DAYS=30
